{
  "compileOnSave": false,
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"],
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "types": []
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "fullTemplateTypeCheck": true
  }
}
